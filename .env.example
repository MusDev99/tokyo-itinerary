# Master Google Spreadsheet ID or full Google Sheet URL
# Share your Google Sheet with: google-sheet-sync@mus-project-2024.iam.gserviceaccount.com
GOOGLE_SHEET_ID=your_google_spreadsheet_id_or_url_here

# Option A (Local Dev): Path to Service Account JSON key file
GOOGLE_CREDENTIALS_PATH=./credentials/keys.json

# Option B (Vercel / Cloud Deployment): Paste the entire contents of credentials/keys.json
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"mus-project-2024",...}
