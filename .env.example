# Master Google Spreadsheet ID or full Google Sheet URL
# Share your Google Sheet with: google-sheet-sync@mus-project-2024.iam.gserviceaccount.com
GOOGLE_SHEET_ID=your_google_spreadsheet_id_or_url_here

# Option A (Local Dev): Path to Service Account JSON key file
GOOGLE_CREDENTIALS_PATH=./credentials/keys.json

# Option B (Vercel / Cloud Deployment): Paste the entire contents of credentials/keys.json
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"mus-project-2024",...}

# --- Google sign-in for editing (viewing stays public) ---
# Create a Web application OAuth client in Google Cloud Console (APIs & Services > Credentials) and add these
# Authorized redirect URIs:  http://localhost:4321/api/auth/google/callback  and  https://<your-domain>/api/auth/google/callback
# Without all of GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET and AUTH_SECRET, editing is disabled (503) everywhere.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# Generate with: openssl rand -base64 32  (>= 16 chars, signs the session cookie)
AUTH_SECRET=at-least-16-random-characters
# Public origin of the site (OAuth redirect base). Optional locally, set it in production.
SITE_URL=http://localhost:4321
# Admin WhatsApp number (country code, digits only) people are sent to when their email isn't registered
ADMIN_WHATSAPP=60123456789
