---
import { pageCacheControl } from '../../../utils/security';
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import CountrySubNav from '../../../components/CountrySubNav.astro';
import TripAnalysis from '../../../components/TripAnalysis.astro';
import { getAllCountriesWithSheets, tripBySlug } from '../../../utils/countries';

Astro.response.headers.set('Cache-Control', pageCacheControl(Boolean(Astro.locals.user)));

const { countries } = await getAllCountriesWithSheets();
const trip = tripBySlug(countries, Astro.params.slug, 'Analysis');
if (!trip) return Astro.redirect('/404');
const { baseCountry, stateMeta, country } = trip;
---

<Layout title={`${stateMeta.name} Trip Budget & Analysis - ${baseCountry.name}`} description={`Spending by category, daily budget and live ${stateMeta.currency} rates for your ${stateMeta.name}, ${baseCountry.name} trip.`}>
  <Header />
  <div class="w-full max-w-7xl mx-auto px-3.5 sm:px-6 lg:px-8 py-5 sm:py-8">
    <CountrySubNav country={country} activeTab="analysis" state={stateMeta} />
    <TripAnalysis
      name={stateMeta.title}
      dataKey={stateMeta.slug}
      days={stateMeta.itinerary}
      currency={stateMeta.currency}
    />
  </div>
  <Footer />
</Layout>
