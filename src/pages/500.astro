---
import Layout from '../layouts/Layout.astro';
import EmptyState from '../components/ui/EmptyState';

// The error page must not depend on Google Sheets (that may be exactly what failed): no Header, no data reads.
Astro.response.headers.set('Cache-Control', 'no-store');
const here = Astro.url.pathname + Astro.url.search;
// Support can find every log line of this request from this id (also the x-request-id response header)
const reference = Astro.locals.requestId;
---

<Layout title="Something went wrong">
  <main class="w-full max-w-md mx-auto px-4 py-16 min-h-screen flex flex-col justify-center">
    <div class="glass-effect rounded-2xl p-6 border border-primary/20 shadow-md">
      <!-- Nielsen: say what happened, what still works, and give one way to recover -->
      <EmptyState icon="🛠️" title="We couldn't load this page" hint="Your trips are safe. The data source didn't answer in time, which usually clears up in a moment.">
        <div class="flex flex-col sm:flex-row gap-2 justify-center">
          <!-- A real navigation to the same URL: works without JavaScript and re-runs the server request -->
          <a href={here} data-astro-reload class="touch-target focus-ring inline-flex items-center justify-center min-h-11 px-5 rounded-xl bg-primary text-white text-sm font-extrabold shadow-md">Try again</a>
          <a href="/" data-astro-reload class="touch-target focus-ring inline-flex items-center justify-center min-h-11 px-5 rounded-xl bg-primary/10 text-primary text-sm font-bold">Go to home</a>
        </div>
      </EmptyState>
      {reference && <p class="mt-3 text-center text-micro text-text/50">Reference: <span class="font-mono select-all">{reference}</span></p>}
    </div>
  </main>
</Layout>
