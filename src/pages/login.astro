---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { safeNext, whatsappLink } from '../utils/auth';
import { authConfig } from '../utils/authEnv';

Astro.response.headers.set('Cache-Control', 'no-store');

const auth = authConfig();
const user = Astro.locals.user;
const next = safeNext(Astro.url.searchParams.get('next'), '/');
const code = Astro.url.searchParams.get('error') ?? '';
const rawEmail = Astro.url.searchParams.get('email') ?? '';
const email = /^[^@\s]{1,100}@[^@\s]{1,100}$/.test(rawEmail) ? rawEmail : '';

// One generic wording per failure: no hints about which check failed (OWASP A07)
const messages: Record<string, string> = {
  cancelled: 'Sign-in was cancelled.',
  invalid: 'That sign-in link expired or was not valid. Please try again.',
  failed: 'Sign-in failed. Please try again in a moment.',
  denied: 'This Google account cannot be used for that email.',
  too_many: 'Too many attempts. Please wait a few minutes and try again.',
};
const message = messages[code] ?? '';
const notRegistered = code === 'not_registered';
const notConfigured = code === 'not_configured' || !auth.configured;
const whatsapp = notRegistered ? whatsappLink(auth.adminWhatsapp, email) : null;
const googleHref = `/api/auth/google?next=${encodeURIComponent(next)}`;
---

<Layout title="Sign in - PlanTravel" noindex>
  <Header />
  <main class="w-full max-w-md mx-auto px-4 py-10 sm:py-16">
    <section class="glass-effect rounded-2xl p-5 sm:p-8 space-y-4">
      <h1 class="text-2xl font-extrabold text-primary">Sign in to edit</h1>
      <p class="text-sm opacity-80">Everyone can view trips. Adding, editing or deleting needs an approved Google account.</p>

      {message && <div role="alert" class="p-3 rounded-xl bg-red-500/10 border border-red-500/30 text-sm font-semibold text-red-800">{message}</div>}

      {notConfigured ? (
        <div role="alert" class="p-3 rounded-xl bg-amber-500/10 border border-amber-500/30 text-sm font-semibold">
          Editing is switched off: set <code>GOOGLE_CLIENT_ID</code>, <code>GOOGLE_CLIENT_SECRET</code> and <code>AUTH_SECRET</code> in the server environment.
        </div>
      ) : notRegistered ? (
        <div class="space-y-3">
          <div role="alert" class="p-3 rounded-xl bg-amber-500/10 border border-amber-500/30 text-sm">
            <p class="font-bold">Your account isn't registered yet.</p>
            {email && <p class="mt-1 break-all">Signed in with <strong>{email}</strong></p>}
            <p class="mt-1">Ask the admin to add your email, then sign in again.</p>
          </div>
          {whatsapp ? (
            <a href={whatsapp} target="_blank" rel="noopener noreferrer" class="touch-target flex items-center justify-center gap-2 px-4 py-3 rounded-xl bg-emerald-600 text-white font-bold">
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.5 3.5A11.9 11.9 0 0012 0C5.4 0 0 5.4 0 12c0 2.1.6 4.200 1.600 6L0 24l6.200-1.600A11.900 11.900 0 0012 24c6.600 0 12-5.400 12-12 0-3.200-1.200-6.200-3.500-8.500zM12 22a9.900 9.900 0 01-5-1.400l-.4-.2-3.700 1 1-3.600-.2-.4A9.900 9.900 0 1122 12c0 5.500-4.500 10-10 10zm5.500-7.400c-.3-.2-1.800-.9-2-1-.3-.1-.5-.2-.7.200-.2.300-.8 1-.9 1.100-.2.200-.3.200-.6.100-.3-.2-1.300-.5-2.400-1.500-.9-.8-1.500-1.800-1.700-2.100-.2-.3 0-.5.100-.6l.5-.5c.1-.2.200-.3.300-.5.100-.2 0-.4 0-.5-.1-.2-.7-1.700-1-2.300-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.100-.8.400-.3.300-1 1-1 2.500s1.100 2.900 1.200 3.100c.2.200 2.100 3.200 5.100 4.500.7.300 1.300.5 1.700.6.700.2 1.400.2 1.900.1.600-.1 1.800-.7 2-1.400.3-.7.300-1.300.2-1.400-.1-.1-.3-.2-.6-.4z"/></svg>
              Ask the admin on WhatsApp
            </a>
          ) : (
            <p class="text-sm font-semibold">Please contact the site admin to request access.</p>
          )}
          <a href={googleHref} class="touch-target flex items-center justify-center px-4 py-3 rounded-xl bg-primary/10 text-primary font-bold">Try a different Google account</a>
        </div>
      ) : user ? (
        <div class="space-y-3">
          <div class="flex items-center gap-3 p-3 rounded-xl bg-white/45 border border-primary/20">
            {user.picture ? (
              <img src={user.picture} alt="" width="40" height="40" referrerpolicy="no-referrer" class="w-10 h-10 rounded-full" />
            ) : (
              <span class="w-10 h-10 rounded-full bg-primary/20 flex items-center justify-center font-bold text-primary">{(user.name || user.email).charAt(0).toUpperCase()}</span>
            )}
            <div class="min-w-0">
              <p class="text-sm font-bold truncate">{user.name || user.email}</p>
              <p class="text-xs opacity-70 truncate">{user.email}</p>
            </div>
          </div>
          <a href={next} class="touch-target flex items-center justify-center px-4 py-3 rounded-xl bg-primary text-white font-bold">Continue</a>
          <form method="post" action="/api/logout">
            <button type="submit" class="touch-target w-full px-4 py-3 rounded-xl bg-primary/10 text-primary font-bold">Sign out</button>
          </form>
        </div>
      ) : (
        <a href={googleHref} class="touch-target flex items-center justify-center gap-3 px-4 py-3 rounded-xl bg-white border border-primary/30 text-gray-800 font-bold shadow-sm hover:shadow-md transition-shadow">
          <svg class="w-5 h-5" viewBox="0 0 48 48" aria-hidden="true"><path fill="#EA4335" d="M24 9.500c3.500 0 6.600 1.200 9.100 3.600l6.800-6.800C35.800 2.400 30.300 0 24 0 14.600 0 6.500 5.400 2.600 13.200l7.900 6.100C12.400 13.600 17.700 9.500 24 9.500z"/><path fill="#4285F4" d="M46.500 24.500c0-1.600-.1-3.100-.4-4.500H24v9h12.700c-.6 3-2.200 5.500-4.700 7.200l7.300 5.700c4.300-4 6.700-9.800 6.700-17.400z"/><path fill="#FBBC05" d="M10.500 28.700A14.500 14.500 0 019.500 24c0-1.600.3-3.200.8-4.700l-7.900-6.100A24 24 0 000 24c0 3.900.9 7.500 2.600 10.800l7.900-6.100z"/><path fill="#34A853" d="M24 48c6.500 0 11.900-2.100 15.900-5.800l-7.300-5.700c-2 1.400-4.700 2.300-8.600 2.300-6.300 0-11.600-4.100-13.500-9.800l-7.900 6.100C6.500 42.600 14.600 48 24 48z"/></svg>
          Continue with Google
        </a>
      )}
    </section>
  </main>
  <Footer />
</Layout>
