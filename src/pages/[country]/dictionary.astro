---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CountrySubNav from '../../components/CountrySubNav.astro';
import { getAllCountries, type CountryMetadata } from '../../utils/countries';

export function getStaticPaths() {
  const countries = getAllCountries();
  return countries.map((country) => ({
    params: { country: country.slug },
    props: { country },
  }));
}

interface Props {
  country: CountryMetadata;
}

const { country } = Astro.props;
const categories: Array<{ name: string; phrases: Array<Record<string, string>> }> =
  country.dictionary?.categories || [];
---

<Layout title={`${country.name} Phrasebook - Travel Planner`}>
  <Header />
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-8">
    <CountrySubNav country={country} activeTab="dictionary" />

    {categories.length > 0 ? (
      <div class="space-y-6">
        <!-- Search & Category Filter Bar (Hick's Law & Miller's Law: Reduce cognitive load) -->
        <div class="glass-effect rounded-2xl p-4 sm:p-5 border border-primary/20 shadow-sm space-y-4">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
            <div class="relative flex-1">
              <svg class="w-4 h-4 text-text/50 absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
              <input
                id="phrase-search"
                type="search"
                placeholder={`Search ${country.name} phrases or English meaning...`}
                class="w-full pl-10 pr-4 py-2.5 rounded-xl bg-white/80 border border-primary/25 text-sm text-text placeholder:text-text/45 focus:outline-none focus:ring-2 focus:ring-primary"
              />
            </div>
            <span id="phrase-count" class="text-xs font-bold text-text/60 shrink-0">
              Showing all categories
            </span>
          </div>

          <!-- Category Quick-Jump Pills (Fitts's Law) -->
          <div class="flex flex-wrap gap-1.5" id="category-pills">
            <button
              type="button"
              data-category="all"
              class="category-pill px-3 py-1.5 rounded-lg text-xs font-bold bg-primary text-white shadow-sm transition-all duration-150"
            >
              All Categories ({categories.length})
            </button>
            {categories.map((cat, idx) => (
              <button
                type="button"
                data-category={`cat-${idx}`}
                class="category-pill px-3 py-1.5 rounded-lg text-xs font-semibold bg-white/70 text-text/75 hover:text-primary hover:bg-primary/10 border border-primary/15 transition-all duration-150"
              >
                {cat.name}
              </button>
            ))}
          </div>
        </div>

        <!-- Phrase Categories (Law of Common Region & Law of Proximity) -->
        <div class="space-y-6" id="phrase-categories-container">
          {categories.map((category, idx) => (
            <section
              data-category-section={`cat-${idx}`}
              class="phrase-category glass-effect rounded-2xl p-5 sm:p-6 border border-primary/20 shadow-sm"
            >
              <div class="flex items-center justify-between gap-2 mb-4 pb-3 border-b border-primary/15">
                <h2 class="text-lg sm:text-xl font-extrabold text-primary">
                  {category.name}
                </h2>
                <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-primary/10 text-primary">
                  {category.phrases.length} phrases
                </span>
              </div>

              <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                {category.phrases.map((phrase) => {
                  const localText = phrase.jp || phrase.local || Object.values(phrase)[0] || '';
                  const englishText = phrase.en || Object.values(phrase)[1] || '';
                  return (
                    <div
                      data-phrase-card
                      data-search={`${localText} ${englishText}`.toLowerCase()}
                      class="group p-4 rounded-xl bg-white/75 hover:bg-white border border-primary/15 hover:border-primary/35 transition-all duration-150 flex items-start justify-between gap-3 shadow-xs"
                    >
                      <div class="space-y-1">
                        <p class="text-sm sm:text-base font-bold text-text leading-snug">
                          {localText}
                        </p>
                        <p class="text-xs sm:text-sm font-medium text-primary/90">
                          {englishText}
                        </p>
                      </div>
                      <button
                        type="button"
                        data-copy={localText}
                        class="copy-phrase-btn shrink-0 p-2 rounded-lg text-text/50 hover:text-primary hover:bg-primary/10 transition-colors"
                        title="Copy phrase"
                        aria-label="Copy phrase"
                      >
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                        </svg>
                      </button>
                    </div>
                  );
                })}
              </div>
            </section>
          ))}
        </div>
      </div>
    ) : (
      <div class="glass-effect rounded-2xl p-8 text-center border border-primary/20">
        <p class="text-lg font-bold text-text">No phrasebook found for {country.name} yet.</p>
        <p class="text-sm text-text/70 mt-1">
          Add <code class="px-1.5 py-0.5 rounded bg-primary/10 text-primary">src/data/{country.slug}/dictionary.json</code> to enable local phrases.
        </p>
      </div>
    )}
  </div>
  <Footer />
</Layout>

<script>
  const searchInput = document.getElementById('phrase-search') as HTMLInputElement | null;
  const pills = document.querySelectorAll<HTMLButtonElement>('.category-pill');
  const sections = document.querySelectorAll<HTMLElement>('.phrase-category');
  const countEl = document.getElementById('phrase-count');
  let activeCategory = 'all';

  function filterPhrases() {
    const query = (searchInput?.value || '').trim().toLowerCase();
    let visibleCount = 0;

    sections.forEach((section) => {
      const catId = section.getAttribute('data-category-section');
      const matchesCat = activeCategory === 'all' || activeCategory === catId;
      if (!matchesCat) {
        section.style.display = 'none';
        return;
      }

      const cards = section.querySelectorAll<HTMLElement>('[data-phrase-card]');
      let sectionMatches = 0;
      cards.forEach((card) => {
        const text = card.getAttribute('data-search') || '';
        const match = !query || text.includes(query);
        card.style.display = match ? '' : 'none';
        if (match) {
          sectionMatches++;
          visibleCount++;
        }
      });

      section.style.display = sectionMatches > 0 ? '' : 'none';
    });

    if (countEl) {
      countEl.textContent = query || activeCategory !== 'all'
        ? `${visibleCount} matching phrases`
        : 'Showing all categories';
    }
  }

  searchInput?.addEventListener('input', filterPhrases);

  pills.forEach((pill) => {
    pill.addEventListener('click', () => {
      activeCategory = pill.getAttribute('data-category') || 'all';
      pills.forEach((p) => {
        const isSelected = p === pill;
        p.className = isSelected
          ? 'category-pill px-3 py-1.5 rounded-lg text-xs font-bold bg-primary text-white shadow-sm transition-all duration-150'
          : 'category-pill px-3 py-1.5 rounded-lg text-xs font-semibold bg-white/70 text-text/75 hover:text-primary hover:bg-primary/10 border border-primary/15 transition-all duration-150';
      });
      filterPhrases();
    });
  });

  document.querySelectorAll<HTMLButtonElement>('.copy-phrase-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const text = btn.getAttribute('data-copy') || '';
      if (!text) return;
      try {
        await navigator.clipboard.writeText(text);
        const original = btn.innerHTML;
        btn.innerHTML = '<span class="text-xs font-bold text-primary">✓</span>';
        setTimeout(() => {
          btn.innerHTML = original;
        }, 1200);
      } catch {}
    });
  });
</script>
