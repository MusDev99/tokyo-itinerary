---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CountrySubNav from '../../components/CountrySubNav.astro';
import PrayerDashboard from '../../components/PrayerDashboard';
import { getAllCountries, type CountryMetadata } from '../../utils/countries';

export function getStaticPaths() {
  const countries = getAllCountries();
  return countries.map((country) => ({
    params: { country: country.slug },
    props: { country },
  }));
}

interface Props {
  country: CountryMetadata;
}

const { country } = Astro.props;
---

<Layout title={`${country.name} Prayer Times - Travel Planner`}>
  <Header />
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-8">
    <CountrySubNav country={country} activeTab="prayer" />

    {country.stats.hasPrayer ? (
      <div class="glass-effect rounded-2xl p-4 sm:p-6 border border-primary/20 shadow-md">
        <PrayerDashboard prayerData={country.prayer} client:load />
      </div>
    ) : (
      <div class="glass-effect rounded-2xl p-8 text-center border border-primary/20">
        <p class="text-lg font-bold text-text">No prayer schedule configured for {country.name} yet.</p>
        <p class="text-sm text-text/70 mt-1">
          Add <code class="px-1.5 py-0.5 rounded bg-primary/10 text-primary">src/data/{country.slug}/prayer.json</code> to enable the prayer time dial.
        </p>
      </div>
    )}
  </div>
  <Footer />
</Layout>
