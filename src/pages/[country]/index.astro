---
import { pageCacheControl } from '../../utils/security';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CountrySubNav from '../../components/CountrySubNav.astro';
import AnalyticsDashboard from '../../components/AnalyticsDashboard';
import DaysOverview from '../../components/DaysOverview.astro';
import { getAllCountriesWithSheets, plainCountryTrip } from '../../utils/countries';

Astro.response.headers.set('Cache-Control', pageCacheControl(Boolean(Astro.locals.user)));

const { countries } = await getAllCountriesWithSheets();
const country = countries.find((c) => c.slug === Astro.params.country?.toLowerCase());

if (!country) {
  return Astro.redirect('/404');
}
// A country that was a single plain tab (no state) is that trip: show the trip, as before
const plain = plainCountryTrip(country);
if (plain) return Astro.redirect(`/trips/${plain.slug}/overview`);

const countryDataSource = country.stats.hasItinerary
  ? { [country.slug]: country.itinerary }
  : {};
---

<Layout title={`${country.name} Hub - Travel Planner`}>
  <Header />
  <div class="w-full max-w-7xl mx-auto px-3.5 sm:px-6 lg:px-8 py-5 sm:py-8">
    <CountrySubNav country={country} activeTab="overview" />

    {country.stats.hasItinerary ? (
      <div class="space-y-6 sm:space-y-8">
        <section aria-label="Destinations in this country" class="glass-effect rounded-2xl p-4 sm:p-6 border border-primary/20 shadow-md">
          <h2 class="text-lg sm:text-xl font-extrabold text-text mb-1">Trips</h2>
          <p class="text-xs sm:text-sm text-text/70 mb-4">Open a trip for its days, budget and Pocket.</p>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 sm:gap-4">
            {country.states.map((st) => (
              <a
                href={`/trips/${st.slug}`}
                class="group bg-white/45 hover:bg-white rounded-xl p-4 border border-primary/15 hover:border-primary/40 shadow-xs hover:shadow-md transition-[color,background-color,border-color,box-shadow,opacity,transform] duration-150 flex items-center justify-between gap-3"
              >
                <div class="min-w-0">
                  <h3 class="text-base font-bold text-text group-hover:text-primary transition-colors truncate">{st.legacy ? `📍 ${st.name}` : st.title}</h3>
                  <p class="text-xs text-text/70 mt-0.5 truncate">
                    {st.cities.length > 0 && !st.legacy ? `${st.cities.join(' → ')} · ` : ''}{st.stats.totalDays} {st.stats.totalDays === 1 ? 'day' : 'days'} · {st.stats.totalActivities} activities
                  </p>
                </div>
                <span class="text-primary font-bold shrink-0">→</span>
              </a>
            ))}
          </div>
        </section>

        <DaysOverview days={country.itinerary} currency={country.currency} itineraryHref={`/${country.slug}/itinerary`} />

        <!-- Country Analytics & Currency Exchange -->
        <section aria-label={`${country.name} Analytics & Currency`} class="glass-effect rounded-2xl p-3.5 sm:p-6 border border-primary/20 shadow-md">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-4 pb-3 border-b border-primary/15">
            <div>
              <h2 class="text-lg sm:text-xl font-extrabold text-text">
                {country.flag} {country.name} Budget & Currency Analytics
              </h2>
              <p class="text-xs sm:text-sm text-text/70">
                Live {country.currency} conversion, category breakdown, and daily expenditure insights
              </p>
            </div>
          </div>
          <AnalyticsDashboard dataSources={countryDataSource} currencies={[country.currency]} client:visible />
        </section>
      </div>
    ) : (
      <div class="w-full glass-effect rounded-2xl p-8 sm:p-12 border border-primary/20 shadow-md text-center max-w-2xl mx-auto my-8">
        <!-- Empty / Coming Soon state -->
        <div class="w-20 h-20 rounded-3xl bg-primary/15 border border-primary/25 flex items-center justify-center text-5xl mx-auto mb-5">
          {country.flag}
        </div>
        <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-amber-500/15 text-amber-800 border border-amber-500/30">
          Itinerary In Planning
        </span>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-text mt-4">
          {country.name} Itinerary Coming Soon
        </h2>
        <p class="text-sm sm:text-base text-text/75 mt-2 leading-relaxed">
          No activities have been added for this destination yet. Add some to unlock the interactive timeline, analytics, and currency converter.
        </p>
        <div class="mt-6 flex flex-wrap justify-center gap-3">
          <a
            href="/"
            class="touch-target inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-primary text-white text-sm font-bold shadow-sm hover:opacity-95 transition-opacity"
          >
            <span>← Back to All Destinations</span>
          </a>
        </div>
      </div>
    )}
  </div>
  <Footer />
</Layout>
