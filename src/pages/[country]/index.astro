---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CountrySubNav from '../../components/CountrySubNav.astro';
import AnalyticsDashboard from '../../components/AnalyticsDashboard';
import { getAllCountriesWithSheets } from '../../utils/countries';

Astro.response.headers.set('Cache-Control', 'no-store, max-age=0');

const { countries } = await getAllCountriesWithSheets();
const country = countries.find((c) => c.slug === Astro.params.country?.toLowerCase());

if (!country) {
  return Astro.redirect('/404');
}

const countryDataSource = country.stats.hasItinerary
  ? { [country.slug]: country.itinerary }
  : {};
---

<Layout title={`${country.name} Hub - Travel Planner`}>
  <Header />
  <div class="w-full max-w-7xl mx-auto px-3.5 sm:px-6 lg:px-8 py-5 sm:py-8">
    <CountrySubNav country={country} activeTab="overview" />

    {country.stats.hasItinerary ? (
      <div class="space-y-6 sm:space-y-8">
        {country.states.length > 0 && (
          <section aria-label="Destinations in this country" class="glass-effect rounded-2xl p-4 sm:p-6 border border-primary/20 shadow-md">
            <h2 class="text-lg sm:text-xl font-extrabold text-text mb-1">States & Cities</h2>
            <p class="text-xs sm:text-sm text-text/70 mb-4">Each place has its own itinerary.</p>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 sm:gap-4">
              {country.states.map((st) => (
                <a
                  href={`/${country.slug}/${st.slug}`}
                  class="group bg-white/45 hover:bg-white rounded-xl p-4 border border-primary/15 hover:border-primary/40 shadow-xs hover:shadow-md transition-all duration-150 flex items-center justify-between gap-3"
                >
                  <div class="min-w-0">
                    <h3 class="text-base font-bold text-text group-hover:text-primary transition-colors truncate">📍 {st.name}</h3>
                    <p class="text-xs text-text/70 mt-0.5">
                      {st.stats.totalDays} {st.stats.totalDays === 1 ? 'day' : 'days'} · {st.stats.totalActivities} activities
                    </p>
                  </div>
                  <span class="text-primary font-bold shrink-0">→</span>
                </a>
              ))}
            </div>
          </section>
        )}

        <!-- Quick Day Preview Grid (Miller's Law: Chunked daily overview) -->
        <section aria-label="Days Overview" class="glass-effect rounded-2xl p-4 sm:p-6 border border-primary/20 shadow-md">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-4 sm:mb-5 pb-3 border-b border-primary/15">
            <div>
              <h2 class="text-lg sm:text-xl font-extrabold text-text">Daily Schedule Summary</h2>
              <p class="text-xs sm:text-sm text-text/70">
                Select any day to jump directly into the interactive timeline
              </p>
            </div>
            <a
              href={`/${country.slug}/itinerary`}
              class="touch-target inline-flex items-center justify-center gap-2 px-4 py-2 rounded-xl bg-primary text-white text-xs sm:text-sm font-bold shadow-sm hover:opacity-95 transition-opacity w-full sm:w-auto"
            >
              <span>Open Full {country.stats.totalDays}-Day Timeline</span>
              <span>→</span>
            </a>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4">
            {country.itinerary.map((day) => {
              const dayTotal = day.items.reduce((acc, item) => acc + (item.price?.amount || 0), 0);
              return (
                <a
                  href={`/${country.slug}/itinerary?day=${day.day}`}
                  class="group bg-white/45 hover:bg-white rounded-xl p-4 border border-primary/15 hover:border-primary/40 shadow-xs hover:shadow-md transition-all duration-150 flex flex-col justify-between"
                >
                  <div>
                    <div class="flex items-center justify-between gap-2 mb-2">
                      <span class="px-2.5 py-0.5 rounded-lg text-xs font-extrabold bg-primary text-white">
                        Day {day.day}
                      </span>
                      <span class="text-xs font-medium text-text/60">{day.date}</span>
                    </div>
                    <h3 class="text-base font-bold text-text group-hover:text-primary transition-colors line-clamp-2">
                      {day.title}
                    </h3>
                  </div>
                  <div class="mt-4 pt-3 border-t border-primary/10 flex items-center justify-between text-xs text-text/75">
                    <span>{day.items.length} activities</span>
                    <span class="font-bold text-primary">
                      {dayTotal > 0 ? `${dayTotal.toLocaleString()} ${country.currency}` : 'Free'}
                    </span>
                  </div>
                </a>
              );
            })}
          </div>
        </section>

        <!-- Country Analytics & Currency Exchange -->
        <section aria-label={`${country.name} Analytics & Currency`} class="glass-effect rounded-2xl p-3.5 sm:p-6 border border-primary/20 shadow-md">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-4 pb-3 border-b border-primary/15">
            <div>
              <h2 class="text-lg sm:text-xl font-extrabold text-text">
                {country.flag} {country.name} Budget & Currency Analytics
              </h2>
              <p class="text-xs sm:text-sm text-text/70">
                Live {country.currency} conversion, category breakdown, and daily expenditure insights
              </p>
            </div>
          </div>
          <AnalyticsDashboard dataSources={countryDataSource} client:load />
        </section>
      </div>
    ) : (
      <!-- Empty / Coming Soon State with developer instructions -->
      <div class="w-full glass-effect rounded-2xl p-8 sm:p-12 border border-primary/20 shadow-md text-center max-w-2xl mx-auto my-8">
        <div class="w-20 h-20 rounded-3xl bg-primary/15 border border-primary/25 flex items-center justify-center text-5xl mx-auto mb-5">
          {country.flag}
        </div>
        <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-amber-500/15 text-amber-800 border border-amber-500/30">
          Itinerary In Planning
        </span>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-text mt-4">
          {country.name} Itinerary Coming Soon
        </h2>
        <p class="text-sm sm:text-base text-text/75 mt-2 leading-relaxed">
          This destination is discovered from the <code class="px-1.5 py-0.5 rounded bg-primary/10 text-primary font-mono text-xs">{country.tabName}</code> tab in Google Sheets. Add activity rows to the worksheet tab to automatically unlock the interactive timeline, analytics, and currency converter.
        </p>
        <div class="mt-6 flex flex-wrap justify-center gap-3">
          <a
            href="/"
            class="touch-target inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-primary text-white text-sm font-bold shadow-sm hover:opacity-95 transition-opacity"
          >
            <span>← Back to All Destinations</span>
          </a>
        </div>
      </div>
    )}
  </div>
  <Footer />
</Layout>
