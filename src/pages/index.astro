---
import { pageCacheControl } from '../utils/security';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AnalyticsDashboard from '../components/AnalyticsDashboard';
import WorldMap from '../components/WorldMap.astro';
import TodayCard from '../components/TodayCard';
import { slimDays, type TodayTrip } from '../utils/today';
import { WELCOME_COOKIE, shouldShowWelcome } from '../utils/welcome';
import { getAllCountriesWithSheets, getActiveItinerariesMap } from '../utils/countries';

// First visit as a guest: show what PlanTravel is before the trip list. Never cached (the answer changes with the cookie).
const h = Astro.request.headers;
if (
  shouldShowWelcome({
    method: Astro.request.method,
    signedIn: Boolean(Astro.locals.user),
    seen: Astro.cookies.get(WELCOME_COOKIE)?.value,
    accept: h.get('accept'),
    userAgent: h.get('user-agent'),
    purpose: h.get('sec-purpose') ?? h.get('purpose'),
  })
) {
  return new Response(null, { status: 302, headers: { Location: '/welcome', 'Cache-Control': 'private, no-store' } });
}

Astro.response.headers.set('Cache-Control', pageCacheControl(Boolean(Astro.locals.user)));

const { countries } = await getAllCountriesWithSheets();
const allItineraries = getActiveItinerariesMap(countries);

const DAY = 86_400_000;
const startOfToday = new Date();
startOfToday.setHours(0, 0, 0, 0);

const parse = (d: string | null) => {
  if (!d) return null;
  const t = new Date(d);
  return isNaN(t.getTime()) ? null : t;
};
const short = (d: Date) => d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });

// One lightweight record per trip: what it is, when, and where it stands (Upcoming / Ongoing / Past)
const trips = countries
  .filter((c) => c.stats.hasItinerary)
  .map((c) => {
    const start = parse(c.stats.firstDate);
    const end = parse(c.stats.lastDate) ?? start;
    let status: 'upcoming' | 'ongoing' | 'past' | 'undated' = 'undated';
    let statusLabel = '';
    if (start && end) {
      if (startOfToday < start) {
        status = 'upcoming';
        const days = Math.ceil((start.getTime() - startOfToday.getTime()) / DAY);
        statusLabel = days === 1 ? 'Tomorrow' : `In ${days} days`;
      } else if (startOfToday <= end) {
        status = 'ongoing';
        statusLabel = 'Happening now';
      } else {
        status = 'past';
        statusLabel = 'Completed';
      }
    }
    const range = start
      ? `${short(start)}${end && end.getTime() !== start.getTime() ? ` – ${short(end)}` : ''}, ${(end ?? start).getFullYear()}`
      : null;
    return { c, start, status, statusLabel, range };
  })
  // Ongoing first, then soonest upcoming, then past
  .sort((a, b) => {
    const rank = { ongoing: 0, upcoming: 1, undated: 2, past: 3 } as const;
    if (rank[a.status] !== rank[b.status]) return rank[a.status] - rank[b.status];
    return (a.start?.getTime() ?? 0) - (b.start?.getTime() ?? 0);
  });

// Today mode: trips with a day within ±1 day of the server's date (the card decides "today" from the
// traveller's own clock). Dev sends every trip so `?today=` can preview any date.
const nearToday = (first: string | null, last: string | null) => {
  if (import.meta.env.DEV) return true;
  const s = parse(first);
  const e = parse(last) ?? s;
  return Boolean(s && e && s.getTime() - DAY <= startOfToday.getTime() && startOfToday.getTime() <= e.getTime() + DAY);
};
const todayTrips: TodayTrip[] = countries.flatMap((c) =>
  c.states.length
    ? c.states
        .filter((st) => st.stats.hasItinerary && nearToday(st.stats.firstDate, st.stats.lastDate))
        .map((st) => ({ name: `${st.name}, ${c.name}`, flag: c.flag, href: `/${c.slug}/${st.slug}`, region: st.name, days: slimDays(st.itinerary) }))
    : c.stats.hasItinerary && nearToday(c.stats.firstDate, c.stats.lastDate)
      ? [{ name: c.name, flag: c.flag, href: `/${c.slug}/itinerary`, region: c.name, days: slimDays(c.itinerary) }]
      : [],
);

const upcomingCountries = countries.filter((c) => !c.stats.hasItinerary);
const totalDays = trips.reduce((n, t) => n + t.c.stats.totalDays, 0);
const totalActivities = trips.reduce((n, t) => n + t.c.stats.totalActivities, 0);

const statusStyle = {
  ongoing: 'bg-emerald-500/20 text-emerald-900 border-emerald-500/40',
  upcoming: 'bg-primary/15 text-primary border-primary/30',
  past: 'bg-text/10 text-text/60 border-text/15',
  undated: 'bg-text/10 text-text/60 border-text/15',
} as const;
import { COLLAPSE_AFTER } from '../utils/countryList';
---

<Layout title="PlanTravel – Your Trips">
  <Header />
  <div class="w-full max-w-7xl mx-auto px-3.5 sm:px-6 lg:px-8 py-5 sm:py-8">
    <!-- Outside the spacing group: when there is no trip day the card renders nothing and leaves no gap -->
    {todayTrips.length > 0 && <TodayCard trips={todayTrips} client:load />}
    <div class="space-y-6 sm:space-y-8">
      <!-- Hero: one title, one primary action, three numbers (Miller's Law). Everything else lives below. -->
      <section data-reveal class="glass-effect rounded-2xl sm:rounded-3xl p-4 sm:p-7 flex flex-col md:flex-row md:items-center justify-between gap-4 sm:gap-6">
        <div class="space-y-1">
          <h1 class="text-2xl sm:text-4xl font-extrabold text-text tracking-tight">Your trips</h1>
          <p class="text-sm text-text/70">
            {trips.length > 0
              ? `${totalDays} days and ${totalActivities} activities planned across ${trips.length} ${trips.length === 1 ? 'country' : 'countries'}.`
              : 'Nothing planned yet. Start with your first trip.'}
          </p>
        </div>
        {Astro.locals.user ? (
          <a
            href="/add"
            class="touch-target inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl bg-primary text-white text-sm font-extrabold shadow-md hover:opacity-95 active:scale-[0.98] transition-[color,background-color,border-color,box-shadow,opacity,transform] w-full md:w-auto"
          >
            <span aria-hidden="true">＋</span>
            <span>New itinerary</span>
          </a>
        ) : (
          <a
            href="/login?next=/add"
            class="touch-target inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl bg-primary/10 text-primary text-sm font-extrabold hover:bg-primary/20 transition-colors w-full md:w-auto"
          >
            Sign in to edit
          </a>
        )}
      </section>

      <!-- World map: look first, open second. Collapsed on phones would hide the best guest entry, so it stays open (Hick: one card, chips below). -->
      {countries.length > 0 && (
        <section data-reveal aria-labelledby="map-heading" class="space-y-3">
          <h2 id="map-heading" class="text-lg sm:text-xl font-extrabold text-text px-1">World map</h2>
          <div class="glass-effect rounded-2xl sm:rounded-3xl p-3 sm:p-5"><WorldMap countries={countries} /></div>
        </section>
      )}

      <!-- Trips: one tappable card each, soonest first (Von Restorff: status chip marks what's next) -->
      {trips.length > 0 && (
        <section aria-labelledby="trips-heading" class="space-y-3">
          <div class="flex items-center justify-between gap-3 px-1 scroll-mt-20" id="destinations">
            <h2 id="trips-heading" class="text-lg sm:text-xl font-extrabold text-text">Destinations <span class="text-sm font-bold text-text/50">({trips.length})</span></h2>
          </div>
          {trips.length > COLLAPSE_AFTER && (
            <div>
              <label for="trip-search" class="sr-only">Search destinations</label>
              <input
                id="trip-search" type="search" autocomplete="off" enterkeyhint="search"
                placeholder="Search country or city"
                class="w-full min-w-0 h-11 px-4 rounded-xl glass-effect text-base text-text placeholder:text-text/40 focus:outline-none focus:ring-2 focus:ring-primary/40"
                data-filter-input
              />
            </div>
          )}
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 sm:gap-4" data-filter-root data-limit={COLLAPSE_AFTER}>
            {trips.map(({ c, status, statusLabel, range }) => (
              <article
                data-filter-item
                data-name={`${c.name} ${c.states.map((st) => st.name).join(' ')}`}
                data-reveal
                data-card
                class="cv-card relative glass-effect rounded-2xl p-4 sm:p-5 hover:border-primary/50 hover:shadow-lg transition-shadow duration-150 flex flex-col gap-3"
              >
                <div class="flex items-start justify-between gap-3">
                  <div class="flex items-center gap-3 min-w-0">
                    <div class="w-12 h-12 rounded-2xl bg-primary/15 border border-primary/25 flex items-center justify-center text-2xl shrink-0">
                      {c.flag}
                    </div>
                    <div class="min-w-0">
                      <h3 class="text-lg font-extrabold text-text leading-tight truncate">
                        <!-- Stretched link: the whole card opens the trip -->
                        <a href={`/${c.slug}`} class="after:absolute after:inset-0 after:content-[''] focus-ring rounded">
                          {c.name}
                        </a>
                      </h3>
                      <p class="text-xs text-text/65 mt-0.5">{range ?? `${c.stats.totalDays} days`}</p>
                    </div>
                  </div>
                  {statusLabel && (
                    <span class:list={['px-2 py-1 rounded-full text-[10px] font-extrabold uppercase tracking-wide border shrink-0 whitespace-nowrap', statusStyle[status]]}>
                      {statusLabel}
                    </span>
                  )}
                </div>

                <div class="flex items-center justify-between gap-3 text-sm">
                  <span class="text-text/75">{c.stats.totalDays} {c.stats.totalDays === 1 ? 'day' : 'days'} · {c.stats.totalActivities} {c.stats.totalActivities === 1 ? 'activity' : 'activities'}</span>
                  <span class="font-extrabold text-primary whitespace-nowrap">
                    {c.stats.totalLocalCost > 0 ? `${Math.round(c.stats.totalLocalCost).toLocaleString()} ${c.currency}` : 'No costs'}
                  </span>
                </div>

                {c.states.length > 0 && (
                  <ul class="relative z-10 flex flex-wrap gap-1.5" aria-label={`Places in ${c.name}`}>
                    {c.states.map((s) => (
                      <li>
                        <a
                          href={`/${c.slug}/${s.slug}`}
                          class="touch-target inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-white/45 border border-primary/20 text-xs font-semibold text-text/80 hover:text-primary hover:border-primary/40 transition-colors"
                        >
                          <span aria-hidden="true">📍</span>{s.name}
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </article>
            ))}
          </div>
                  {trips.length > COLLAPSE_AFTER && (
            <div class="space-y-2">
              <p data-filter-empty style="display:none" role="status" class="px-3 py-6 text-center text-sm text-text/60">No destination matches your search.</p>
              <button type="button" data-filter-more
                class="touch-target w-full sm:w-auto sm:mx-auto sm:flex rounded-2xl border-2 border-dashed border-primary/35 px-5 py-3 text-sm font-bold text-primary hover:bg-primary/10 justify-center">
                Show all {trips.length} destinations
              </button>
            </div>
          )}
        </section>
      )}

      <!-- Analytics collapsed by default (Hick's Law: progressive disclosure) -->
      {trips.length > 0 && (
        <details data-reveal class="group glass-effect rounded-2xl sm:rounded-3xl overflow-hidden">
          <summary class="cursor-pointer list-none p-4 sm:p-6 flex items-center justify-between gap-3 hover:bg-primary/5 transition-colors select-none">
            <span class="flex items-center gap-3 min-w-0">
              <span class="w-10 h-10 rounded-xl bg-primary/15 flex items-center justify-center text-lg shrink-0" aria-hidden="true">📊</span>
              <span class="min-w-0">
                <span class="block text-base sm:text-lg font-extrabold text-text">Spending & currency</span>
                <span class="block text-xs sm:text-sm text-text/70">Budget breakdown across countries and live exchange rates</span>
              </span>
            </span>
            <svg class="w-5 h-5 text-text/60 shrink-0 transition-transform duration-150 group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </summary>
          <div class="p-3.5 sm:p-6 border-t border-primary/15">
            <AnalyticsDashboard dataSources={allItineraries} currencies={trips.map((t) => t.c.currency)} client:visible />
          </div>
        </details>
      )}

      <!-- Wishlist: compact chips, secondary to real trips -->
      {upcomingCountries.length > 0 && (
        <section data-reveal aria-labelledby="wishlist-heading" class="space-y-2">
          <h2 id="wishlist-heading" class="text-sm font-bold uppercase tracking-wider text-text/60 px-1">Wishlist (no activities yet)</h2>
          <div class="flex flex-wrap gap-2">
            {upcomingCountries.map((c) => (
              <a
                href={`/${c.slug}`}
                class="touch-target inline-flex items-center gap-2 px-3.5 py-2 rounded-full glass-effect text-sm font-semibold text-text/85 hover:text-primary transition-colors"
              >
                <span aria-hidden="true">{c.flag}</span>{c.name}
              </a>
            ))}
          </div>
        </section>
      )}
    </div>
  </div>
  <Footer />
</Layout>

<script>

  import { onPageLoad } from '../utils/pageLoad';

  // Re-runs after every soft navigation (the body is swapped, bundled scripts do not re-execute)
  onPageLoad(() => {
  // Search + "Show all" for long destination lists (plain DOM: no hydration cost for 100+ cards).
  // Same rules as utils/countryList.ts: a search shows every match; otherwise the first N until "Show all".
  const root = document.querySelector<HTMLElement>('[data-filter-root]');
  if (root) {
    const limit = Number(root.dataset.limit) || 8;
    const items = Array.from(root.querySelectorAll<HTMLElement>('[data-filter-item]'));
    const input = document.querySelector<HTMLInputElement>('[data-filter-input]');
    const more = document.querySelector<HTMLButtonElement>('[data-filter-more]');
    const empty = document.querySelector<HTMLElement>('[data-filter-empty]');
    const fold = (v: string) => v.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().trim();
    let showAll = items.length <= limit;
    const render = () => {
      const q = fold(input?.value || '');
      let shown = 0;
      items.forEach((el, i) => {
        const hit = q ? fold(el.dataset.name || '').includes(q) : showAll || i < limit;
        el.style.display = hit ? '' : 'none'; // not [hidden]: a Tailwind flex/grid class would override it
        if (hit) shown++;
      });
      if (more) more.style.display = q || showAll ? 'none' : '';
      if (empty) empty.style.display = shown > 0 ? 'none' : '';
    };
    input?.addEventListener('input', render);
    more?.addEventListener('click', () => { showAll = true; render(); });
    render();
  }
  });
</script>

<script>
  import { animate, stagger, hover } from 'motion';

  // Staggered entrance + subtle card lift; skipped for reduced motion
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const items = Array.from(document.querySelectorAll<HTMLElement>('[data-reveal]'));
    items.forEach((el) => (el.style.opacity = '0'));
    animate(items, { opacity: [0, 1], y: [18, 0] }, { delay: stagger(0.07), duration: 0.5, ease: [0.22, 1, 0.36, 1] });

    document.querySelectorAll<HTMLElement>('[data-card]').forEach((card) => {
      hover(card, () => {
        animate(card, { y: -3 }, { type: 'spring', stiffness: 400, damping: 24 });
        return () => animate(card, { y: 0 }, { type: 'spring', stiffness: 400, damping: 24 });
      });
    });
  }
</script>
