---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import TripWizard from '../components/TripWizard';
import { getAllCountriesWithSheets, getCountryOptions } from '../utils/countries';
import { toIsoDate } from '../utils/calendar';

Astro.response.headers.set('Cache-Control', 'no-store, max-age=0');

const initialCountry = Astro.url.searchParams.get('country') || '';
const initialState = Astro.url.searchParams.get('state') || '';

const { countries } = await getAllCountriesWithSheets();

const trips = countries.flatMap((c) =>
  c.states.length > 0
    ? c.states.filter((s) => s.legacy && s.tabName.includes(' - ')).map((s) => ({ country: c.name, state: s.name }))
    : []
);

// Trips that can be copied: just what the picker shows (the rows stay on the server). Newest first, as in each country.
const copyTrips = countries
  .flatMap((c) => c.states.filter((s) => s.stats.hasItinerary).map((s) => ({
    slug: s.slug,
    title: s.title,
    country: c.name,
    cities: s.cities,
    start: s.stats.firstDate ? toIsoDate(s.stats.firstDate) : '',
    end: s.stats.lastDate ? toIsoDate(s.stats.lastDate) : '',
    days: s.itinerary.map((d) => ({ date: toIsoDate(d.date), title: d.title, items: d.items.length })).filter((d) => d.date && d.items > 0),
  })))
  .filter((t) => t.days.length > 0)
  .sort((a, b) => b.start.localeCompare(a.start));

// Known defaults plus any countries already in the sheet
const options = getCountryOptions();
for (const c of countries) {
  if (!options.some((o) => o.slug === c.slug)) {
    options.push({ name: c.name, slug: c.slug, flag: c.flag, currency: c.currency });
  }
}
---

<Layout title="New Trip - Travel Planner" noindex>
  <Header />
  <div class="w-full max-w-7xl mx-auto px-3.5 sm:px-6 lg:px-8 py-5 sm:py-8">
    <div class="w-full max-w-xl mx-auto mb-5 sm:mb-6">
      <h1 class="text-2xl sm:text-3xl font-extrabold text-text tracking-tight">Plan a new trip</h1>
      <p class="text-sm text-text/70 mt-1">
        Three quick steps, then add places day by day.
      </p>
    </div>
    <TripWizard countries={options} trips={trips} copyTrips={copyTrips} initialCountry={initialCountry} initialState={initialState} client:load />
  </div>
  <Footer />
</Layout>
