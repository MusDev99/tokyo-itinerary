---
import type { DayItinerary } from '../types/itinerary';

interface Props {
  days: DayItinerary[];
  currency: string;
  /** The trip's itinerary page; each day links to `${itineraryHref}?day=N` */
  itineraryHref: string;
}

const { days, currency, itineraryHref } = Astro.props;
---

<!-- Days as a list of rows, not a grid of cards in a card (Law of Common Region: one surface; Miller's Law: one fact
     per column). Each row jumps into that day of the timeline; the Itinerary tab is in the dock, so no second button. -->
<section aria-label="Days Overview" class="glass-effect rounded-2xl px-3 sm:px-6 py-2 sm:py-4 border border-primary/20 shadow-md">
  <h2 class="sr-only">Days</h2>
  <ul class="divide-y divide-primary/10">
    {days.map((day) => {
      const dayTotal = day.items.reduce((acc, item) => acc + (item.price?.amount || 0), 0);
      return (
        <li>
          <a
            href={`${itineraryHref}?day=${day.day}`}
            class="group cv-card touch-target flex items-center gap-3 py-3 min-h-[56px]"
          >
            <span class="shrink-0 w-11 text-center">
              <span class="block text-micro font-bold uppercase tracking-wide text-text/50">Day</span>
              <span class="block text-lg font-extrabold text-primary leading-none">{day.day}</span>
            </span>
            <span class="min-w-0 flex-1">
              <span class="block text-sm sm:text-base font-bold text-text group-hover:text-primary transition-colors truncate">{day.title}</span>
              <span class="block text-xs text-text/60 truncate">{day.date} · {day.items.length} {day.items.length === 1 ? 'activity' : 'activities'}</span>
            </span>
            <span class="shrink-0 text-xs font-bold text-primary">{dayTotal > 0 ? `${dayTotal.toLocaleString()} ${currency}` : 'Free'}</span>
            <span class="shrink-0 text-text/40" aria-hidden="true">›</span>
          </a>
        </li>
      );
    })}
  </ul>
</section>
