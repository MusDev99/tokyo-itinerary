---
import type { CountryMetadata } from '../utils/countries';

interface Props {
  country: CountryMetadata;
  activeTab: 'overview' | 'itinerary';
}

const { country, activeTab } = Astro.props;

const tabs = [
  {
    key: 'overview',
    label: 'Overview',
    icon: '🧭',
    href: `/${country.slug}`,
    available: true,
  },
  {
    key: 'itinerary',
    label: 'Itinerary',
    icon: '🗓️',
    href: `/${country.slug}/itinerary`,
    badge: country.stats.totalDays > 0 ? `${country.stats.totalDays}d` : undefined,
    available: country.stats.hasItinerary,
  },
].filter((t) => t.available);
---

<div class="flex flex-col gap-3 sm:gap-4 mb-5 sm:mb-6">
  <!-- Jakob's Law: Familiar Breadcrumb Navigation -->
  <nav aria-label="Breadcrumb" class="flex flex-wrap items-center gap-1.5 sm:gap-2 text-xs sm:text-sm font-medium text-text/60">
    <a href="/" class="hover:text-primary transition-colors flex items-center gap-1">
      <span>🌍</span>
      <span>Destinations</span>
    </a>
    <span aria-hidden="true">/</span>
    <a href={`/${country.slug}`} class="hover:text-primary transition-colors flex items-center gap-1 font-semibold text-text/80">
      <span>{country.flag}</span>
      <span>{country.name}</span>
    </a>
    {activeTab !== 'overview' && (
      <>
        <span aria-hidden="true">/</span>
        <span class="text-primary font-bold capitalize">{activeTab}</span>
      </>
    )}
  </nav>

  <!-- Hero Header + Sub-navigation Switcher (Law of Common Region & Fitts's Law) -->
  <div class="glass-effect rounded-2xl p-4 sm:p-6 border border-primary/20 shadow-md flex flex-col lg:flex-row lg:items-center justify-between gap-4">
    <div class="flex items-start sm:items-center gap-3.5 sm:gap-4">
      <div class="w-12 h-12 sm:w-16 sm:h-16 rounded-2xl bg-primary/15 border border-primary/25 flex items-center justify-center text-2xl sm:text-4xl shadow-inner shrink-0">
        {country.flag}
      </div>
      <div class="min-w-0">
        <div class="flex flex-wrap items-center gap-2">
          <h1 class="text-xl sm:text-3xl font-extrabold text-text tracking-tight">
            {country.title}
          </h1>
          <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-primary/15 text-primary border border-primary/25">
            {country.currency}
          </span>
        </div>
        <p class="text-xs sm:text-sm text-text/75 mt-1 max-w-2xl leading-relaxed">
          {country.description}
        </p>

        {/* Quick Metadata Chips (Miller's Law: Chunked into 4 scannable badges) */}
        {country.stats.hasItinerary && (
          <div class="flex flex-wrap items-center gap-1.5 sm:gap-2 mt-3">
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-white/70 border border-primary/15 text-[11px] sm:text-xs font-semibold text-text/80">
              <span>📅</span>
              <span>{country.stats.totalDays} Days ({country.stats.totalActivities} Activities)</span>
            </span>
            {country.region && (
              <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-white/70 border border-primary/15 text-[11px] sm:text-xs font-semibold text-text/80">
                <span>📍</span>
                <span>{country.region}</span>
              </span>
            )}
            {country.season && (
              <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-white/70 border border-primary/15 text-[11px] sm:text-xs font-semibold text-text/80">
                <span>🌤️</span>
                <span>{country.season}</span>
              </span>
            )}
            {country.stats.firstDate && (
              <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-white/70 border border-primary/15 text-[11px] sm:text-xs font-semibold text-text/80">
                <span>🛫</span>
                <span>{country.stats.firstDate}</span>
              </span>
            )}
          </div>
        )}
      </div>
    </div>

    <!-- Country Tool Switcher (Fitts's Law: Large 44px touch targets, full width on mobile) -->
    {tabs.length > 1 && (
      <div class="grid grid-cols-2 sm:flex items-center gap-1.5 p-1.5 rounded-xl bg-white/60 border border-primary/20 w-full sm:w-auto self-stretch sm:self-start lg:self-center shrink-0">
        {tabs.map((tab) => {
          const isCurrent = activeTab === tab.key;
          return (
            <a
              href={tab.href}
              class:list={[
                'touch-target inline-flex items-center justify-center gap-1.5 px-3.5 py-2 rounded-lg text-xs sm:text-sm font-bold transition-all duration-150',
                isCurrent
                  ? 'bg-primary text-white shadow-sm'
                  : 'text-text/75 hover:text-primary hover:bg-primary/10',
              ]}
              aria-current={isCurrent ? 'page' : undefined}
            >
              <span>{tab.icon}</span>
              <span>{tab.label}</span>
              {tab.badge && (
                <span
                  class:list={[
                    'text-[10px] px-1.5 py-0.5 rounded-full',
                    isCurrent ? 'bg-white/25 text-white' : 'bg-primary/15 text-primary',
                  ]}
                >
                  {tab.badge}
                </span>
              )}
            </a>
          );
        })}
      </div>
    )}
  </div>
</div>
