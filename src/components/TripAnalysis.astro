---
import AnalyticsDashboard from './AnalyticsDashboard';
import type { DayItinerary } from '../types/itinerary';

interface Props {
  /** e.g. "Tokyo, Japan" */
  name: string;
  /** Data source key for the dashboard */
  dataKey: string;
  days: DayItinerary[];
  currency: string;
}

const { name, dataKey, days, currency } = Astro.props;
---

<!-- A trip's Analysis tab: the dashboard is the page (open, no wrapper card or repeated title: it has its own panels and the tab name is in the dock) -->
{days.length > 0 ? (
  <section aria-label={`${name}: budget & currency`}>
    <AnalyticsDashboard dataSources={{ [dataKey]: days }} currencies={[currency]} client:load />
  </section>
) : (
  <div class="glass-effect rounded-2xl p-8 text-center border border-primary/20">
    <p class="text-lg font-bold text-text">No activities to analyse yet.</p>
    <p class="text-sm text-text/70 mt-1">Add activities with prices to see the budget breakdown.</p>
  </div>
)}
