---
import { getAllCountriesWithSheets } from '../utils/countries';
import MobileNav from './MobileNav';
import BackButton from './BackButton';
import UserMenu from './UserMenu';

const { countries } = await getAllCountriesWithSheets();

const navLinks = countries.map((country) => {
  const sublinks: Array<{ href: string; text: string; icon: string }> = [
    { href: `/${country.slug}/itinerary`, text: 'Interactive Timeline', icon: '🗓️' },
  ];
  for (const st of country.states) {
    sublinks.push({ href: `/trips/${st.slug}`, text: st.legacy ? st.name : st.title, icon: '📍' });
    sublinks.push({ href: `/trips/${st.slug}/pocket`, text: `${st.legacy ? st.name : st.title} pocket`, icon: '🎒' });
  }

  return {
    slug: country.slug,
    text: country.name,
    flag: country.flag,
    href: country.stats.hasItinerary ? `/${country.slug}/itinerary` : `/${country.slug}`,
    hubHref: `/${country.slug}`,
    hasItinerary: country.stats.hasItinerary,
    daysCount: country.stats.totalDays,
    sublinks: country.stats.hasItinerary ? sublinks : undefined,
  };
});

const currentPath = Astro.url.pathname;

// Past ~6 destinations the pill row overflows: keep the first few (plus the one you are in) and move the rest to "More".
const MAX_PILLS = 5;
const activeIdx = navLinks.findIndex((l) => currentPath === l.hubHref || currentPath.startsWith(`/${l.slug}/`));
const pills = navLinks.filter((_, i) => i < MAX_PILLS || i === activeIdx);
const morePills = navLinks.filter((l) => !pills.includes(l));
const user = Astro.locals.user;
const signedInUser = user ? { name: user.name, email: user.email, picture: user.picture } : null;

const mobileCountries = countries.map((c) => ({
  slug: c.slug,
  name: c.name,
  flag: c.flag,
  days: c.stats.totalDays,
  hubHref: `/${c.slug}`,
  itineraryHref: c.stats.hasItinerary ? `/${c.slug}/itinerary` : null,
  toolsHref: null,
  states: c.states.map((st) => ({ name: st.legacy ? st.name : st.title, href: `/trips/${st.slug}`, toolsHref: `/trips/${st.slug}/pocket`, days: st.stats.totalDays })),
}));
---

<header class="sticky top-0 z-50 glass-effect bg-white/60 border-b border-primary/20">
  <div class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <!-- Brand / Home Link (Jakob's Law & Fitts's Law) -->
      <div class="flex items-center gap-2 sm:gap-4">
        <!-- Back to the previous page (hidden on the home page) -->
        <BackButton path={Astro.url.pathname} client:idle />
        <a
          href="/"
          class="flex items-center gap-2.5 py-2 group focus-ring rounded-lg"
          aria-label="Global Itinerary Home"
        >
          <img
            src="/logo.svg"
            alt=""
            width="36"
            height="36"
            class="w-9 h-9 drop-shadow-sm group-hover:scale-110 group-hover:-rotate-6 transition-transform duration-200"
          />
          <div class="flex flex-col">
            <span class="text-base sm:text-lg font-extrabold text-text tracking-tight leading-none">
              PlanTravel
            </span>
            <span class="text-[11px] font-medium text-text/60 leading-tight">
              Travel & Expense Intelligence
            </span>
          </div>
        </a>
      </div>

      <!-- Desktop Navigation (Miller's Law: Chunked & clear active states) -->
      <nav class="hidden xl:flex items-center gap-1.5" aria-label="Main Navigation">
        <a
          href="/"
          class:list={[
            'px-3.5 py-2 rounded-xl text-sm font-semibold transition-[color,background-color,border-color,box-shadow,opacity,transform] duration-150 flex items-center gap-1.5 shrink-0',
            currentPath === '/'
              ? 'bg-primary text-white shadow-sm'
              : 'text-text/80 hover:bg-primary/10 hover:text-primary',
          ]}
          aria-current={currentPath === '/' ? 'page' : undefined}
        >
          <span>🌍</span>
          <span>Dashboard</span>
        </a>

        <div class="h-4 w-px bg-primary/20 mx-1 shrink-0" aria-hidden="true"></div>

        {pills.map((link) => {
          const isActive = currentPath === link.hubHref || currentPath.startsWith(`/${link.slug}/`);
          return (
            <div class="relative group shrink-0">
              <a
                href={link.href}
                class:list={[
                  'px-3 py-2 rounded-xl text-sm font-semibold transition-[color,background-color,border-color,box-shadow,opacity,transform] duration-150 flex items-center gap-1.5 whitespace-nowrap',
                  isActive
                    ? 'bg-primary text-white shadow-sm'
                    : 'text-text/80 hover:bg-primary/10 hover:text-primary',
                ]}
                aria-current={isActive ? 'page' : undefined}
              >
                <span>{link.flag}</span>
                <span>{link.text}</span>
                {link.daysCount > 0 && (
                  <span
                    class:list={[
                      'text-[10px] px-1.5 py-0.5 rounded-full font-bold',
                      isActive ? 'bg-white/25 text-white' : 'bg-primary/15 text-primary',
                    ]}
                  >
                    {link.daysCount}d
                  </span>
                )}
                {link.sublinks && (
                  <svg
                    class="w-3.5 h-3.5 ml-0.5 transition-transform duration-200 group-hover:rotate-180 opacity-80"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
                  </svg>
                )}
              </a>

              {/* Fitts's Law: Continuous hover bridge (pt-2) prevents menu loss */}
              {link.sublinks && (
                <div class="absolute top-full left-0 pt-2 w-52 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-[color,background-color,border-color,box-shadow,opacity,transform] duration-150 z-50">
                  <div class="bg-surface-solid rounded-2xl shadow-xl border border-primary/20 p-1.5 flex flex-col gap-0.5">
                    <a
                      href={link.hubHref}
                      class:list={[
                        'flex items-center justify-between px-3 py-2 rounded-xl text-xs font-semibold transition-colors',
                        currentPath === link.hubHref
                          ? 'bg-primary/15 text-primary'
                          : 'text-text/70 hover:bg-primary/10 hover:text-primary',
                      ]}
                    >
                      <span>{link.flag} {link.text} Overview</span>
                      <span>→</span>
                    </a>
                    <div class="h-px bg-primary/10 my-0.5"></div>
                    {link.sublinks.map((sublink) => {
                      const isSubActive =
                        currentPath === sublink.href || currentPath === `${sublink.href}/`;
                      return (
                        <a
                          href={sublink.href}
                          class:list={[
                            'flex items-center gap-2.5 px-3 py-2.5 rounded-xl text-sm font-medium transition-colors',
                            isSubActive
                              ? 'bg-primary text-white font-semibold shadow-sm'
                              : 'text-text/80 hover:bg-primary/10 hover:text-primary',
                          ]}
                        >
                          <span>{sublink.icon}</span>
                          <span>{sublink.text}</span>
                        </a>
                      );
                    })}
                  </div>
                </div>
              )}
            </div>
          );
        })}

        {morePills.length > 0 && (
          <div class="relative group shrink-0">
            <button
              type="button"
              class="px-3 py-2 rounded-xl text-sm font-semibold flex items-center gap-1.5 whitespace-nowrap text-text/80 hover:bg-primary/10 hover:text-primary focus-ring"
              aria-haspopup="true"
            >
              <span>More</span>
              <span class="text-[10px] px-1.5 py-0.5 rounded-full font-bold bg-primary/15 text-primary">{morePills.length}</span>
              <svg class="w-3.5 h-3.5 transition-transform duration-200 group-hover:rotate-180 group-focus-within:rotate-180 opacity-80" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
            <!-- Hick's Law: a scrolling list instead of 100 pills; the full searchable list lives on the dashboard -->
            <div class="absolute top-full right-0 pt-2 w-64 opacity-0 invisible group-hover:opacity-100 group-hover:visible group-focus-within:opacity-100 group-focus-within:visible transition-[color,background-color,border-color,box-shadow,opacity,transform] duration-150 z-50">
              <div class="bg-surface-solid rounded-2xl shadow-xl border border-primary/20 p-1.5 flex flex-col">
                <div class="max-h-[60vh] overflow-y-auto overscroll-contain flex flex-col gap-0.5">
                  {morePills.map((link) => (
                    <a href={link.href} class="flex items-center justify-between gap-2 px-3 py-2.5 rounded-xl text-sm font-medium text-text/80 hover:bg-primary/10 hover:text-primary transition-colors">
                      <span class="flex items-center gap-2 min-w-0"><span>{link.flag}</span><span class="truncate">{link.text}</span></span>
                      {link.daysCount > 0 && <span class="text-[10px] px-1.5 py-0.5 rounded-full font-bold bg-primary/15 text-primary shrink-0">{link.daysCount}d</span>}
                    </a>
                  ))}
                </div>
                <a href="/#destinations" class="mt-1 px-3 py-2.5 rounded-xl text-xs font-bold text-primary bg-primary/10 text-center hover:bg-primary/15">Search all destinations →</a>
              </div>
            </div>
          </div>
        )}
      </nav>

      <!-- Mobile navigation (quick add + animated slide-in drawer) -->
      <div class="flex items-center gap-1">
        <UserMenu user={signedInUser} next={currentPath === '/login' ? '/' : currentPath} client:idle />
        <MobileNav countries={mobileCountries} currentPath={currentPath} canEdit={Boolean(user)} client:idle />
      </div>
    </div>
  </div>

</header>
