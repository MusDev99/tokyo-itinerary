---
import { getAllCountriesWithSheets } from '../utils/countries';

const { countries } = await getAllCountriesWithSheets();

const navLinks = countries.map((country) => {
  const sublinks: Array<{ href: string; text: string; icon: string }> = [
    { href: `/${country.slug}/itinerary`, text: 'Interactive Timeline', icon: '🗓️' },
  ];

  return {
    slug: country.slug,
    text: country.name,
    flag: country.flag,
    href: country.stats.hasItinerary ? `/${country.slug}/itinerary` : `/${country.slug}`,
    hubHref: `/${country.slug}`,
    hasItinerary: country.stats.hasItinerary,
    daysCount: country.stats.totalDays,
    sublinks: country.stats.hasItinerary ? sublinks : undefined,
  };
});

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 glass-effect border-b border-primary/20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <!-- Brand / Home Link (Jakob's Law & Fitts's Law) -->
      <div class="flex items-center gap-6">
        <a
          href="/"
          class="flex items-center gap-2.5 py-2 group focus-ring rounded-lg"
          aria-label="Global Itinerary Home"
        >
          <div class="w-9 h-9 rounded-xl bg-primary text-white flex items-center justify-center shadow-sm group-hover:scale-105 transition-transform duration-200">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" class="w-5 h-5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />
            </svg>
          </div>
          <div class="flex flex-col">
            <span class="text-base sm:text-lg font-extrabold text-text tracking-tight leading-none">
              WanderPlan
            </span>
            <span class="text-[11px] font-medium text-text/60 leading-tight">
              Travel & Expense Intelligence
            </span>
          </div>
        </a>
      </div>

      <!-- Desktop Navigation (Miller's Law: Chunked & clear active states) -->
      <nav class="hidden md:flex items-center gap-1.5" aria-label="Main Navigation">
        <a
          href="/"
          class:list={[
            'px-3.5 py-2 rounded-xl text-sm font-semibold transition-all duration-150 flex items-center gap-1.5',
            currentPath === '/'
              ? 'bg-primary text-white shadow-sm'
              : 'text-text/80 hover:bg-primary/10 hover:text-primary',
          ]}
          aria-current={currentPath === '/' ? 'page' : undefined}
        >
          <span>🌍</span>
          <span>Dashboard</span>
        </a>

        <div class="h-4 w-px bg-primary/20 mx-1" aria-hidden="true"></div>

        {navLinks.map((link) => {
          const isActive = currentPath === link.hubHref || currentPath.startsWith(`/${link.slug}/`);
          return (
            <div class="relative group">
              <a
                href={link.href}
                class:list={[
                  'px-3.5 py-2 rounded-xl text-sm font-semibold transition-all duration-150 flex items-center gap-1.5',
                  isActive
                    ? 'bg-primary text-white shadow-sm'
                    : 'text-text/80 hover:bg-primary/10 hover:text-primary',
                ]}
                aria-current={isActive ? 'page' : undefined}
              >
                <span>{link.flag}</span>
                <span>{link.text}</span>
                {link.daysCount > 0 && (
                  <span
                    class:list={[
                      'text-[10px] px-1.5 py-0.5 rounded-full font-bold',
                      isActive ? 'bg-white/25 text-white' : 'bg-primary/15 text-primary',
                    ]}
                  >
                    {link.daysCount}d
                  </span>
                )}
                {link.sublinks && (
                  <svg
                    class="w-3.5 h-3.5 ml-0.5 transition-transform duration-200 group-hover:rotate-180 opacity-80"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
                  </svg>
                )}
              </a>

              {/* Fitts's Law: Continuous hover bridge (pt-2) prevents menu loss */}
              {link.sublinks && (
                <div class="absolute top-full left-0 pt-2 w-52 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-150 z-50">
                  <div class="glass-effect bg-white/95 rounded-2xl shadow-xl border border-primary/20 p-1.5 flex flex-col gap-0.5">
                    <a
                      href={link.hubHref}
                      class:list={[
                        'flex items-center justify-between px-3 py-2 rounded-xl text-xs font-semibold transition-colors',
                        currentPath === link.hubHref
                          ? 'bg-primary/15 text-primary'
                          : 'text-text/70 hover:bg-primary/10 hover:text-primary',
                      ]}
                    >
                      <span>{link.flag} {link.text} Overview</span>
                      <span>→</span>
                    </a>
                    <div class="h-px bg-primary/10 my-0.5"></div>
                    {link.sublinks.map((sublink) => {
                      const isSubActive =
                        currentPath === sublink.href || currentPath === `${sublink.href}/`;
                      return (
                        <a
                          href={sublink.href}
                          class:list={[
                            'flex items-center gap-2.5 px-3 py-2.5 rounded-xl text-sm font-medium transition-colors',
                            isSubActive
                              ? 'bg-primary text-white font-semibold shadow-sm'
                              : 'text-text/80 hover:bg-primary/10 hover:text-primary',
                          ]}
                        >
                          <span>{sublink.icon}</span>
                          <span>{sublink.text}</span>
                        </a>
                      );
                    })}
                  </div>
                </div>
              )}
            </div>
          );
        })}
      </nav>

      <!-- Mobile menu button (Fitts's Law: 44x44 touch target) -->
      <div class="flex items-center md:hidden">
        <button
          type="button"
          id="menu-toggle"
          class="touch-target inline-flex items-center justify-center p-2.5 rounded-xl text-text hover:text-primary hover:bg-primary/10 focus-ring"
          aria-controls="mobile-menu"
          aria-expanded="false"
        >
          <span class="sr-only">Open navigation menu</span>
          <svg id="menu-open-icon" class="block h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="menu-close-icon" class="hidden h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Menu Drawer -->
  <div class="md:hidden hidden border-t border-primary/15 bg-white/95 backdrop-blur-xl" id="mobile-menu">
    <div class="px-4 pt-3 pb-5 space-y-2">
      <a
        href="/"
        class:list={[
          'flex items-center gap-2.5 px-3.5 py-2.5 rounded-xl text-base font-semibold',
          currentPath === '/'
            ? 'bg-primary text-white'
            : 'text-text hover:bg-primary/10',
        ]}
      >
        <span>🌍</span>
        <span>Global Dashboard</span>
      </a>

      <div class="pt-2 pb-1 px-2 text-xs font-bold uppercase tracking-wider text-text/50">
        Destinations ({navLinks.length})
      </div>

      {navLinks.map((link) => {
        const isActive = currentPath === link.hubHref || currentPath.startsWith(`/${link.slug}/`);
        return (
          <div class="rounded-xl border border-primary/15 bg-bg/40 p-2">
            <a
              href={link.href}
              class:list={[
                'flex items-center justify-between px-3 py-2 rounded-lg text-base font-bold',
                isActive ? 'text-primary' : 'text-text',
              ]}
            >
              <span class="flex items-center gap-2">
                <span>{link.flag}</span>
                <span>{link.text}</span>
              </span>
              {link.daysCount > 0 ? (
                <span class="text-xs px-2 py-0.5 rounded-full bg-primary/15 text-primary font-semibold">
                  {link.daysCount} Days
                </span>
              ) : (
                <span class="text-xs px-2 py-0.5 rounded-full bg-text/10 text-text/60">
                  Planning
                </span>
              )}
            </a>

            {link.sublinks && (
              <div class="grid grid-cols-3 gap-1.5 mt-2 pt-2 border-t border-primary/10">
                {link.sublinks.map((sublink) => {
                  const isSubActive =
                    currentPath === sublink.href || currentPath === `${sublink.href}/`;
                  return (
                    <a
                      href={sublink.href}
                      class:list={[
                        'flex flex-col items-center justify-center py-2 px-2 rounded-lg text-xs font-semibold text-center transition-colors',
                        isSubActive
                          ? 'bg-primary text-white shadow-sm'
                          : 'bg-white/70 text-text/80 hover:bg-primary/10',
                      ]}
                    >
                      <span class="text-base mb-0.5">{sublink.icon}</span>
                      <span>{sublink.text}</span>
                    </a>
                  );
                })}
              </div>
            )}
          </div>
        );
      })}
    </div>
  </div>
</header>

<script>
  const menuToggle = document.getElementById('menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const openIcon = document.getElementById('menu-open-icon');
  const closeIcon = document.getElementById('menu-close-icon');

  if (menuToggle && mobileMenu && openIcon && closeIcon) {
    menuToggle.addEventListener('click', () => {
      const isExpanded = menuToggle.getAttribute('aria-expanded') === 'true';
      menuToggle.setAttribute('aria-expanded', String(!isExpanded));
      mobileMenu.classList.toggle('hidden');
      openIcon.classList.toggle('block');
      openIcon.classList.toggle('hidden');
      closeIcon.classList.toggle('hidden');
      closeIcon.classList.toggle('block');
    });
  }
</script>
