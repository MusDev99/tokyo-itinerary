---
import { getAllCountriesWithSheets } from '../utils/countries';
import MobileNav from './MobileNav';
import BackButton from './BackButton';
import UserMenu from './UserMenu';

const { countries } = await getAllCountriesWithSheets();

const navLinks = countries.map((country) => {
  const sublinks: Array<{ href: string; text: string; icon: string }> = [
    { href: `/${country.slug}/itinerary`, text: 'Interactive Timeline', icon: '🗓️' },
  ];
  for (const st of country.states) {
    sublinks.push({ href: `/${country.slug}/${st.slug}`, text: st.name, icon: '📍' });
    sublinks.push({ href: `/${country.slug}/${st.slug}/tools`, text: `${st.name} tools`, icon: '🕌' });
  }
  if (country.states.length === 0) {
    sublinks.push({ href: `/${country.slug}/tools`, text: 'Travel tools', icon: '🕌' });
  }

  return {
    slug: country.slug,
    text: country.name,
    flag: country.flag,
    href: country.stats.hasItinerary ? `/${country.slug}/itinerary` : `/${country.slug}`,
    hubHref: `/${country.slug}`,
    hasItinerary: country.stats.hasItinerary,
    daysCount: country.stats.totalDays,
    sublinks: country.stats.hasItinerary ? sublinks : undefined,
  };
});

const currentPath = Astro.url.pathname;
const user = Astro.locals.user;
const signedInUser = user ? { name: user.name, email: user.email, picture: user.picture } : null;

const mobileCountries = countries.map((c) => ({
  slug: c.slug,
  name: c.name,
  flag: c.flag,
  days: c.stats.totalDays,
  hubHref: `/${c.slug}`,
  itineraryHref: c.stats.hasItinerary ? `/${c.slug}/itinerary` : null,
  toolsHref: c.states.length === 0 ? `/${c.slug}/tools` : null,
  states: c.states.map((st) => ({ name: st.name, href: `/${c.slug}/${st.slug}`, toolsHref: `/${c.slug}/${st.slug}/tools`, days: st.stats.totalDays })),
}));
---

<header class="sticky top-0 z-50 glass-effect bg-white/60 border-b border-primary/20">
  <div class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <!-- Brand / Home Link (Jakob's Law & Fitts's Law) -->
      <div class="flex items-center gap-2 sm:gap-4">
        <!-- Back to the previous page (hidden on the home page) -->
        <BackButton path={Astro.url.pathname} client:load />
        <a
          href="/"
          class="flex items-center gap-2.5 py-2 group focus-ring rounded-lg"
          aria-label="Global Itinerary Home"
        >
          <img
            src="/logo.svg"
            alt=""
            width="36"
            height="36"
            class="w-9 h-9 drop-shadow-sm group-hover:scale-110 group-hover:-rotate-6 transition-transform duration-200"
          />
          <div class="flex flex-col">
            <span class="text-base sm:text-lg font-extrabold text-text tracking-tight leading-none">
              PlanTravel
            </span>
            <span class="text-[11px] font-medium text-text/60 leading-tight">
              Travel & Expense Intelligence
            </span>
          </div>
        </a>
      </div>

      <!-- Desktop Navigation (Miller's Law: Chunked & clear active states) -->
      <nav class="hidden xl:flex items-center gap-1.5" aria-label="Main Navigation">
        <a
          href="/"
          class:list={[
            'px-3.5 py-2 rounded-xl text-sm font-semibold transition-all duration-150 flex items-center gap-1.5 shrink-0',
            currentPath === '/'
              ? 'bg-primary text-white shadow-sm'
              : 'text-text/80 hover:bg-primary/10 hover:text-primary',
          ]}
          aria-current={currentPath === '/' ? 'page' : undefined}
        >
          <span>🌍</span>
          <span>Dashboard</span>
        </a>

        <div class="h-4 w-px bg-primary/20 mx-1 shrink-0" aria-hidden="true"></div>

        {navLinks.map((link) => {
          const isActive = currentPath === link.hubHref || currentPath.startsWith(`/${link.slug}/`);
          return (
            <div class="relative group shrink-0">
              <a
                href={link.href}
                class:list={[
                  'px-3 py-2 rounded-xl text-sm font-semibold transition-all duration-150 flex items-center gap-1.5 whitespace-nowrap',
                  isActive
                    ? 'bg-primary text-white shadow-sm'
                    : 'text-text/80 hover:bg-primary/10 hover:text-primary',
                ]}
                aria-current={isActive ? 'page' : undefined}
              >
                <span>{link.flag}</span>
                <span>{link.text}</span>
                {link.daysCount > 0 && (
                  <span
                    class:list={[
                      'text-[10px] px-1.5 py-0.5 rounded-full font-bold',
                      isActive ? 'bg-white/25 text-white' : 'bg-primary/15 text-primary',
                    ]}
                  >
                    {link.daysCount}d
                  </span>
                )}
                {link.sublinks && (
                  <svg
                    class="w-3.5 h-3.5 ml-0.5 transition-transform duration-200 group-hover:rotate-180 opacity-80"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
                  </svg>
                )}
              </a>

              {/* Fitts's Law: Continuous hover bridge (pt-2) prevents menu loss */}
              {link.sublinks && (
                <div class="absolute top-full left-0 pt-2 w-52 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-150 z-50">
                  <div class="glass-effect bg-surface-solid rounded-2xl shadow-xl border border-primary/20 p-1.5 flex flex-col gap-0.5">
                    <a
                      href={link.hubHref}
                      class:list={[
                        'flex items-center justify-between px-3 py-2 rounded-xl text-xs font-semibold transition-colors',
                        currentPath === link.hubHref
                          ? 'bg-primary/15 text-primary'
                          : 'text-text/70 hover:bg-primary/10 hover:text-primary',
                      ]}
                    >
                      <span>{link.flag} {link.text} Overview</span>
                      <span>→</span>
                    </a>
                    <div class="h-px bg-primary/10 my-0.5"></div>
                    {link.sublinks.map((sublink) => {
                      const isSubActive =
                        currentPath === sublink.href || currentPath === `${sublink.href}/`;
                      return (
                        <a
                          href={sublink.href}
                          class:list={[
                            'flex items-center gap-2.5 px-3 py-2.5 rounded-xl text-sm font-medium transition-colors',
                            isSubActive
                              ? 'bg-primary text-white font-semibold shadow-sm'
                              : 'text-text/80 hover:bg-primary/10 hover:text-primary',
                          ]}
                        >
                          <span>{sublink.icon}</span>
                          <span>{sublink.text}</span>
                        </a>
                      );
                    })}
                  </div>
                </div>
              )}
            </div>
          );
        })}
      </nav>

      <!-- Mobile navigation (quick add + animated slide-in drawer) -->
      <div class="flex items-center gap-1">
        <UserMenu user={signedInUser} next={currentPath === '/login' ? '/' : currentPath} client:load />
        <MobileNav countries={mobileCountries} currentPath={currentPath} canEdit={Boolean(user)} client:load />
      </div>
    </div>
  </div>

</header>
