---
import FooterContent from './FooterContent';
import { getAllCountriesWithSheets } from '../utils/countries';

const { countries } = await getAllCountriesWithSheets();

const destinations = countries.map((c) => ({
  slug: c.slug,
  name: c.name,
  flag: c.flag,
  href: c.stats.hasItinerary ? `/${c.slug}/itinerary` : `/${c.slug}`,
  days: c.stats.totalDays,
}));
---
<footer class="mt-10 bg-gradient-to-b from-transparent to-secondary/30 border-t border-primary/20 backdrop-blur-sm">
  <FooterContent destinations={destinations} year={new Date().getFullYear()} canEdit={Boolean(Astro.locals.user)} client:visible />
</footer>
