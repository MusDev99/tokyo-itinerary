---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import SeasonBackground from '../components/SeasonBackground';
import OfflineStatus from '../components/OfflineStatus';
import Toaster from '../components/ui/Toaster';
import NavProgress from '../components/NavProgress.astro';

interface Props {
  title: string;
  /** <= 160 chars; shown in search results and link previews. */
  description?: string;
  /** Admin-only screens (login, add) stay out of search results. */
  noindex?: boolean;
  /** false: the page paints its own backdrop (the welcome page), so the animated season layer is not mounted. */
  seasonBackground?: boolean;
}

const DEFAULT_DESCRIPTION =
  'Day-by-day travel itineraries with maps, budget analytics, currency conversion and travel tools for every trip.';
const { title, description = DEFAULT_DESCRIPTION, noindex = false, seasonBackground = true } = Astro.props;
// Canonical drops the query string so ?country=... variants don't compete with the clean URL
// Soft navigation: header, tab dock and content swap in place instead of reloading the page. PUBLIC_SOFT_NAV=0 turns it off.
const softNav = import.meta.env.PUBLIC_SOFT_NAV !== '0';
const canonical = new URL(Astro.url.pathname, Astro.url.origin).toString();
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Noto+Sans+JP:wght@400;500;700&display=swap" rel="stylesheet" />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- PWA: installable, reads offline (public/sw.js) -->
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="PlanTravel" />
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="PlanTravel" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="theme-color" content="#7c3aed" />
    {softNav && <ClientRouter />}
    <script is:inline>
      // Apply the saved season before first paint (no flash of the wrong theme)
      try {
        var t = localStorage.getItem('theme');
        var ok = ['autumn', 'winter', 'spring', 'summer', 'rain', 'haze', 'night'];
        document.documentElement.setAttribute('data-theme', ok.indexOf(t) > -1 ? t : 'autumn');
      } catch (e) {}
      // Soft navigation replaces <html> attributes with the new page's (which has no data-theme): carry it over
      if (!window.__themeSwap) {
        window.__themeSwap = true;
        document.addEventListener('astro:before-swap', function (e) {
          var cur = document.documentElement.getAttribute('data-theme');
          if (cur) e.newDocument.documentElement.setAttribute('data-theme', cur);
        });
      }
    </script>
  </head>
  <body class="min-h-screen flex flex-col bg-transparent touch-manipulation mobile-safe-area">
    <!-- Loading bar + tab skeleton while the next page loads -->
    <NavProgress />

    <!-- Offline pill + service worker registration -->
    <OfflineStatus client:idle transition:persist transition:name="offline-status" />
    <!-- Toasts (undo, saved, errors): one host for the whole app -->
    <Toaster client:idle transition:persist transition:name="toaster" />

    <!-- Animated season background (Motion) -->
    {seasonBackground && <SeasonBackground client:idle transition:persist transition:name="season-bg" />}

    <!-- Main Content -->
    <div id="page-content" class="relative z-10 flex-1 flex flex-col">
      <slot />
    </div>

  </body>
</html>