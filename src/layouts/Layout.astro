---
import '../styles/global.css';
import ThemeSwitcher from '../components/ThemeSwitcher';
import SeasonBackground from '../components/SeasonBackground';

interface Props {
  title: string;
  /** Admin-only screens (login, add) stay out of search results. */
  noindex?: boolean;
}

const { title, noindex = false } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Noto+Sans+JP:wght@400;500;700&display=swap" rel="stylesheet" />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <title>{title}</title>
    <script is:inline>
      // Apply the saved season before first paint (no flash of the wrong theme)
      try {
        var t = localStorage.getItem('theme');
        var ok = ['autumn', 'winter', 'spring', 'summer', 'rain', 'haze', 'night'];
        document.documentElement.setAttribute('data-theme', ok.indexOf(t) > -1 ? t : 'autumn');
      } catch (e) {}
    </script>
  </head>
  <body class="min-h-screen flex flex-col bg-transparent touch-manipulation mobile-safe-area">
    <!-- Theme Switcher Component (Fitts's Law: Accessible floating trigger in thumb zone) -->
    <div class="fixed bottom-5 right-5 z-40">
      <ThemeSwitcher client:load />
    </div>

    <!-- Animated season background (Motion) -->
    <SeasonBackground client:load />

    <!-- Main Content -->
    <div class="relative z-10 flex-1 flex flex-col">
      <slot />
    </div>

  </body>
</html>